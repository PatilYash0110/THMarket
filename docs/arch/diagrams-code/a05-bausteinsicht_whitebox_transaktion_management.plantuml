@startuml
title Bausteinsicht — Ebene 2: Whitebox Transaktion Management
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam monochrome true
skinparam ArrowColor #333333
skinparam folderBackgroundColor #ECECEC
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 70
top to bottom direction
rectangle "Transaktion Management  (Whitebox — Ebene 2)" as TM {
  folder "Mock Zahlung" as a
  folder "Guthaben Verwaltung" as b
  folder "Bewertungen" as c
}
database "Datenbank" as db

a -down-> b : bei Guthaben-Modus
a -down-> db : Inserat = VERKAUFT
b -down-> db
c -down-> db
@enduml
