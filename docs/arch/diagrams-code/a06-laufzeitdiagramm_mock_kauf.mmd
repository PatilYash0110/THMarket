sequenceDiagram
    autonumber
    actor K as Kaeufer
    participant FE as Frontend
    participant L as ListingsController
    participant SVC as ListingsService
    participant DB as Datenbank

    K->>FE: Kaufen, Zahlungsmodus waehlen
    FE->>L: POST /listings/:id/purchase
    L->>SVC: purchase(id, buyerId, role, dto)
    SVC->>SVC: Berechtigung pruefen (Rolle, Eigentuemer,<br/>Sofortkauf aktiviert)
    alt Methode = Simulation
        SVC->>SVC: Test-Kreditkarte validieren (kein Geldfluss)
        SVC->>DB: Inserat = VERKAUFT, buyerId setzen
    else Methode = In-App-Guthaben
        SVC->>DB: Guthaben pruefen und verrechnen<br/>(Kaeufer -, Verkaeufer +), Inserat = VERKAUFT
    end
    DB-->>SVC: Bestaetigung
    SVC-->>L: Ergebnis
    L-->>FE: Kaufbestaetigung
    FE-->>K: Erfolg anzeigen
